{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.prompt // empty' | grep -qiE '(create|design|build|generate).{0,30}(lead.?magnet|pdf|visual|slide|ebook|landing.?page)|html.{0,20}(asset|lead)' && echo 'DESIGN TASK DETECTED: Before generating visual assets, read docs/guides/brand-guide.md for colours, fonts and style. Use the pdf-leadmagnet skill for PDFs and lead magnets.' || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.prompt // empty' | grep -qiE '/publish|npm.run.publish|ready.to.publish|commit.*push|all.done|tasks?.complete|ready.to.ship' && echo 'CONTENT WORK COMPLETE: Remember to update docs/operations/backlog.md with completed tasks and any new items discovered.' || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm run validate:*)",
      "mcp__Notion__fetch",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "Read(//Users/xavi/Downloads/**)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "mcp__Notion__search",
      "WebSearch",
      "mcp__Notion__notion-update-page",
      "WebFetch(domain:www.notion.so)",
      "mcp__Notion__notion-fetch",
      "WebFetch(domain:ghost.org)",
      "WebFetch(domain:docs.ghost.org)",
      "WebFetch(domain:github.com)",
      "Bash(npm run publish:*)",
      "Bash(cat:*)",
      "WebFetch(domain:docs.n8n.io)",
      "WebFetch(domain:darrelltw.medium.com)",
      "WebFetch(domain:ai-rockstars.com)",
      "Bash(test:*)",
      "WebFetch(domain:danielmiessler.com)",
      "WebFetch(domain:simonwillison.net)",
      "Bash(grep:*)",
      "Bash(npx --version:*)",
      "Bash(git rm:*)",
      "Bash(gh run:*)",
      "Bash(gh workflow run:*)",
      "Bash(DEBUG=1 node scripts/publish.js:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(python:*)",
      "Bash(open:*)",
      "Bash(uv sync:*)",
      "Bash(echo:*)",
      "Bash(npm test)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:glama.ai)",
      "WebFetch(domain:playbooks.com)",
      "Bash(npm view:*)",
      "Bash(npm search:*)"
    ],
    "deny": []
  },
  "enableAllProjectMcpServers": true
}
